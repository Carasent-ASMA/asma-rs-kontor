+    /// The preserved content of imported records, under one import receipt.
+    ///
+    /// This is the read side of the disposition: a Core Team route succession
+    /// from another Realm is *inspectable* here — the whole row, exactly as its
+    /// source wrote it, under the digest its source computed — and it is not
+    /// live. Nothing in this Realm resolves an effect from what this returns.
+    ///
+    /// # Errors
+    /// Returns [`BackupError::Store`] when the table cannot be read.
+    pub fn imported_record_evidence(
+        &self,
+        import_id: &str,
+    ) -> Result<Vec<ImportedRecordEvidenceRow>, BackupError> {
+        let mut statement = self
+            .connection
+            .prepare(
+                "SELECT record_kind, source_identity, content, content_hash, recorded_at
+                 FROM imported_record_evidence WHERE import_id = ?1
+                 ORDER BY record_kind, source_identity",
+            )
+            .map_err(|source| BackupError::Store(source.into()))?;
+        let rows = statement
+            .query_map(params![import_id], |row| {
+                Ok(ImportedRecordEvidenceRow {
+                    record_kind: row.get(0)?,
+                    source_identity: row.get(1)?,
+                    content: row.get(2)?,
+                    content_hash: row.get(3)?,
+                    recorded_at: row.get(4)?,
+                })
+            })
+            .map_err(|source| BackupError::Store(source.into()))?;
+        rows.collect::<Result<Vec<_>, _>>()
+            .map_err(|source| BackupError::Store(source.into()))
+    }
+}
