+/// The record kinds whose content survives an import as readable evidence.
+///
+/// A closed, named list rather than a policy: keeping a record's bytes is a
+/// decision about that record, and one made for a stated reason. The reason for
+/// the one entry here is that a Core Team route succession is the only durable
+/// account of what a route correction did — which predecessor was retired, which
+/// successor replaced it, under which occupancy and grant generation, against
+/// which receipt — and an investigator in another Realm has to be able to read
+/// that account rather than merely confirm a digest over bytes they cannot see.
+///
+/// Membership grants nothing. The content lands in `imported_record_evidence`,
+/// whose schema admits it only beside a lineage row recorded as non-live, whose
+/// rows cannot be rewritten or deleted, and which no destination effect resolves
+/// against. The source idempotency key inside those bytes is a string here: it
+/// is not a key in this Realm, it replays nothing, and it authorizes nothing
+/// (ASMA-8187).
+// MUTANT M-R5a: preserve no content, keeping only the digest.
+const PRESERVED_EVIDENCE_KINDS: [&str; 0] = [];
+
+/// Write the canonical content of every preserved-kind record, as evidence.
+///
+/// Only `Recorded` dispositions are eligible, and the schema enforces that
+/// independently: a record this import materialized is destination state, and a
+/// second unreconciled copy of it beside the lineage would be exactly the
+/// ambiguity the disposition exists to avoid.
+fn write_preserved_evidence(
+    transaction: &Transaction<'_>,
+    now: Timestamp,
+    import_id: Uuid,
+    dispositions: &[(RecordLineage, Disposition)],
+) -> Result<(), BackupError> {
+    for (record, disposition) in dispositions {
+        if !PRESERVED_EVIDENCE_KINDS.contains(&record.kind)
+            || !matches!(disposition, Disposition::Recorded)
+        {
+            continue;
+        }
+        // The bytes the digest was taken over, not a re-encoding of them.
+        let content =
+            serde_json::to_string(&record.content).map_err(|_| BackupError::Verification {
+                detail: "an imported record's content could not be rendered as JSON",
+            })?;
+        transaction
+            .execute(
+                "INSERT INTO imported_record_evidence
+                     (import_id, record_kind, source_identity, content, content_hash, recorded_at)
+                 VALUES (?1, ?2, ?3, ?4, ?5, ?6)",
+                params![
+                    import_id.as_hyphenated().to_string(),
+                    record.kind,
+                    record.identity,
+                    content,
+                    record.hash.as_str(),
+                    format_utc_timestamp(now),
+                ],
+            )
+            .map_err(map_sql)?;
+    }
+    Ok(())
+}
