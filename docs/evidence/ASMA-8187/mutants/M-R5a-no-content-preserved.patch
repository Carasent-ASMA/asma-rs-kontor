+/// One imported record's preserved content, as text.
+///
+/// Evidence, not state. The identifiers inside [`Self::content`] name rows in
+/// the source Realm and resolve against nothing here.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ImportedRecordEvidenceRow {
+    /// The source table the record came from.
+    pub record_kind: String,
+    /// The source record's primary key, rendered as text.
+    pub source_identity: String,
+    /// The exact canonical JSON the source digest was taken over.
+    pub content: String,
+    /// That digest.
+    pub content_hash: String,
+    /// When this Realm recorded the evidence.
+    pub recorded_at: String,
 }
 
