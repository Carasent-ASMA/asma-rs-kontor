+import { afterEach, expect, test, vi } from "vitest";
+import { createPaseoApi, type PaseoApi } from "@getpaseo/client";
+import { DaemonClient } from "./test-utils/daemon-client.js";
+import { createTestPaseoDaemon, type TestPaseoDaemon } from "./test-utils/paseo-daemon.js";
+import { createTestAgentClient } from "./test-utils/fake-agent-client.js";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import pino from "pino";
+import { AgentStorage } from "./agent/agent-storage.js";
+
+const cleanups: (() => Promise<void>)[] = [];
+afterEach(async () => {
+  for (const cleanup of cleanups.splice(0).toReversed()) await cleanup();
+});
+
+async function connect(daemon: TestPaseoDaemon): Promise<PaseoApi> {
+  const client = new DaemonClient({
+    url: `ws://127.0.0.1:${daemon.port}/ws`,
+    appVersion: "0.12.0",
+  });
+  await client.connect();
+  const api = createPaseoApi(client);
+  cleanups.push(async () => {
+    await api.dispose();
+    await client.close();
+  });
+  return api;
+}
+
+test("public markSeen persists, synchronizes, relights, and refuses a newer revision without loading history", async () => {
+  const provider = createTestAgentClient("codex");
+  const created = vi.spyOn(provider, "createSession");
+  const resumed = vi.spyOn(provider, "resumeSession");
+  const daemon = await createTestPaseoDaemon({ agentClients: { codex: provider } });
+  cleanups.push(daemon.close);
+  const api = await connect(daemon);
+  const otherDevice = await connect(daemon);
+  const agent = await api.agents.create({
+    cwd: daemon.staticDir,
+    config: { provider: "codex/test" },
+    title: "Disposable read acknowledgement",
+  });
+  await agent.run("Return one word.");
+  const before = (await agent.refresh())!.agent;
+  expect(before.requiresAttention).toBe(true);
+  expect(before.attentionReason).toBe("finished");
+  const observation = await otherDevice.agents.list({ subscribe: {} });
+  let observedSeen!: () => void;
+  const seenOnOtherDevice = new Promise<void>((resolve) => {
+    observedSeen = resolve;
+  });
+  observation.subscription.subscribe({
+    snapshot: () => {},
+    update: (update) => {
+      if (
+        update.type === "agent_update" &&
+        update.payload.kind === "upsert" &&
+        update.payload.agent.id === agent.id &&
+        !update.payload.agent.requiresAttention
+      )
+        observedSeen();
+    },
+  });
+  const requestsBefore = created.mock.calls.length;
+  const result = await agent.markSeen({
+    expectedUpdatedAt: before.updatedAt,
+    expectedAttentionTimestamp: before.attentionTimestamp ?? null,
+  });
+  expect(result).toMatchObject({
+    agentId: agent.id,
+    outcome: "seen",
+    error: null,
+    agent: {
+      id: agent.id,
+      requiresAttention: false,
+      attentionReason: null,
+      status: before.status,
+      updatedAt: before.updatedAt,
+    },
+  });
+  await seenOnOtherDevice;
+  const reconnected = await connect(daemon);
+  expect((await reconnected.agents.ref(agent.id).refresh())?.agent.requiresAttention).toBe(false);
+  expect(created).toHaveBeenCalledTimes(requestsBefore);
+  expect(resumed).not.toHaveBeenCalled();
+  expect(
+    (
+      await agent.markSeen({
+        expectedUpdatedAt: before.updatedAt,
+        expectedAttentionTimestamp: before.attentionTimestamp ?? null,
+      })
+    ).outcome,
+  ).toBe("already_seen");
+  await agent.run("Return a second word.");
+  const newer = (await agent.refresh())!.agent;
+  expect(newer.requiresAttention).toBe(true);
+  expect(
+    (
+      await agent.markSeen({
+        expectedUpdatedAt: before.updatedAt,
+        expectedAttentionTimestamp: before.attentionTimestamp ?? null,
+      })
+    ).outcome,
+  ).toBe("changed");
+  expect((await agent.refresh())!.agent.requiresAttention).toBe(true);
+  await observation.subscription.release();
+}, 30_000);
+
+test("read acknowledgement remains durable after a metadata flush races the live-state update", async () => {
+  const daemon = await createTestPaseoDaemon({
+    agentClients: { codex: createTestAgentClient("codex") },
+  });
+  cleanups.push(daemon.close);
+  const api = await connect(daemon);
+  const agent = await api.agents.create({
+    cwd: daemon.staticDir,
+    config: { provider: "codex/test" },
+  });
+  await agent.run("Return one word.");
+  const before = (await agent.refresh())!.agent;
+  const acknowledge = AgentStorage.prototype.acknowledgeAttention;
+  const flush = vi
+    .spyOn(AgentStorage.prototype, "acknowledgeAttention")
+    .mockImplementationOnce(async function (this: AgentStorage, input) {
+      const outcome = await acknowledge.call(this, input);
+      if (input.liveAgent) await this.applySnapshot(input.liveAgent);
+      return outcome;
+    });
+  try {
+    expect(
+      (
+        await agent.markSeen({
+          expectedUpdatedAt: before.updatedAt,
+          expectedAttentionTimestamp: before.attentionTimestamp ?? null,
+        })
+      ).outcome,
+    ).toBe("seen");
+    const durable = new AgentStorage(daemon.config.agentStoragePath, pino({ level: "silent" }));
+    expect((await durable.get(agent.id))?.requiresAttention).toBe(false);
+  } finally {
+    flush.mockRestore();
+  }
+}, 30_000);
+
+test("stored-only unread acknowledgement does not resume a broken provider and archives remain archived", async () => {
+  const root = await mkdtemp(path.join(tmpdir(), "paseo-read-ack-"));
+  cleanups.push(() => rm(root, { recursive: true, force: true }));
+  const first = await createTestPaseoDaemon({
