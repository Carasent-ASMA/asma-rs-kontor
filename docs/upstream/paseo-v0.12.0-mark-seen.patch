+import { afterEach, expect, test } from "vitest";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import pino from "pino";
+import { AgentManager, type AgentManagerEvent } from "./agent-manager.js";
+import { AgentStorage, type StoredAgentRecord } from "./agent-storage.js";
+import { buildStoredAgentPayload } from "./agent-projections.js";
+import { createAgentUpdatesService } from "../session/agent-updates/agent-updates-service.js";
+import type { SessionOutboundMessage } from "../messages.js";
+
+const roots: string[] = [];
+afterEach(async () => {
+  for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true });
+});
+
+async function createStoredError(overrides: Partial<StoredAgentRecord> = {}) {
+  const root = await mkdtemp(join(tmpdir(), "paseo-attention-metadata-"));
+  roots.push(root);
+  const logger = pino({ level: "silent" });
+  const storage = new AgentStorage(root, logger);
+  const record: StoredAgentRecord = {
+    id: "00000000-0000-4000-8000-000000000001",
+    workspaceId: "workspace-fixture",
+    provider: "unavailable-provider",
+    cwd: "/fixtures/read-acknowledgement",
+    createdAt: "2026-01-01T00:00:00.000Z",
+    updatedAt: "2026-01-01T00:00:01.000Z",
+    lastStatus: "error",
+    lastError: "Retained provider error",
+    archivedAt: "2026-01-01T00:00:02.000Z",
+    requiresAttention: true,
+    attentionReason: "error",
+    attentionTimestamp: "2026-01-01T00:00:01.000Z",
+    labels: {},
+    ...overrides,
+  };
+  await storage.upsert(record);
+  const manager = new AgentManager({ registry: storage, logger, clients: {} });
+  return { root, logger, storage, record, manager };
+}
+
+test("stored error acknowledgement preserves status through the actual directory subscription", async () => {
+  const { root, logger, record, manager } = await createStoredError();
+  const messages: SessionOutboundMessage[] = [];
+  const events: AgentManagerEvent[] = [];
+  const forwards: Promise<unknown>[] = [];
+  const updates = createAgentUpdatesService({
+    emit: (message) => messages.push(message),
+    enrichAgentPayload: async (payload) => payload,
+    buildStoredAgentPayload: (stored) => buildStoredAgentPayload(stored, []),
+    isProviderVisibleToClient: () => true,
+    buildProjectPlacementForWorkspaceId: async () => ({
+      projectKey: "fixture-project",
+      projectName: "Fixture",
+      checkout: {
+        cwd: record.cwd,
+        isGit: false,
+        worktreeRoot: null,
+        currentBranch: null,
+        remoteUrl: null,
+        isPaseoOwnedWorktree: false,
+        mainRepoRoot: null,
+      },
+    }),
+    emitWorkspaceUpdateForWorkspaceId: async () => {},
+    sequenceAgentUpdate: (payload) => payload,
+    logger,
+  });
+  updates.beginSubscription({
+    subscriptionId: "errors",
+    filter: { includeArchived: true, includeUnavailablePersisted: true, statuses: ["error"] },
+  });
+  updates.flushBootstrapped("errors");
+  updates.beginSubscription({
+    subscriptionId: "closed",
+    filter: { includeArchived: true, includeUnavailablePersisted: true, statuses: ["closed"] },
+  });
+  updates.flushBootstrapped("closed");
+  updates.beginSubscription({
+    subscriptionId: "all",
+    filter: { includeArchived: true, includeUnavailablePersisted: true },
+  });
+  updates.flushBootstrapped("all");
+  updates.beginSubscription({
+    subscriptionId: "active",
+    filter: { includeUnavailablePersisted: true },
+  });
+  updates.flushBootstrapped("active");
+  const unsubscribe = manager.subscribe((event) => {
+    events.push(event);
+    if (event.type === "agent_state") forwards.push(updates.forwardLiveAgent(event.agent));
+    if (event.type === "stored_agent_state")
+      forwards.push(updates.forwardStoredAgent(event.record));
+  });
+  try {
+    expect(
+      await manager.acknowledgeAgentAttention({
+        agentId: record.id,
+        expectedUpdatedAt: record.updatedAt,
+        expectedAttentionTimestamp: record.attentionTimestamp ?? null,
+      }),
+    ).toBe("seen");
+    await Promise.all(forwards);
+    const durable = await new AgentStorage(root, logger).get(record.id);
+    expect(durable).toEqual({
+      ...record,
+      requiresAttention: false,
+      attentionReason: null,
+      attentionTimestamp: null,
+    });
+    expect(events).toHaveLength(1);
+    const event = events[0];
+    if (event.type !== "stored_agent_state") throw new Error("Expected native stored agent state");
+    expect(event.record.lastStatus).toBe("error");
+    expect(messages).toEqual([
+      {
+        type: "agent_update",
+        payload: expect.objectContaining({
+          kind: "upsert",
+          agent: expect.objectContaining({
+            id: record.id,
+            status: "error",
+            lastError: record.lastError,
+            archivedAt: record.archivedAt,
+            providerUnavailable: true,
+            requiresAttention: false,
+          }),
+        }),
+      },
+      { type: "agent_update", payload: { kind: "remove", agentId: record.id } },
+      {
+        type: "agent_update",
+        payload: expect.objectContaining({
+          kind: "upsert",
+          agent: expect.objectContaining({
+            id: record.id,
+            status: "error",
+            lastError: record.lastError,
+            archivedAt: record.archivedAt,
+            providerUnavailable: true,
+            requiresAttention: false,
+          }),
+        }),
+      },
+      { type: "agent_update", payload: { kind: "remove", agentId: record.id } },
+    ]);
+    expect(manager.getAgent(record.id)).toBeNull();
+  } finally {
+    unsubscribe();
+    updates.dispose();
+  }
+});
+
+test.each(["initializing", "running", "idle", "error", "closed"] as const)(
+  "stored acknowledgement preserves %s metadata and only reaches its exact native subscribers",
+  async (lastStatus) => {
+    const { record, storage, manager } = await createStoredError({ lastStatus, archivedAt: null });
+    const exact: AgentManagerEvent[] = [];
+    const other: AgentManagerEvent[] = [];
+    const unsubscribeExact = manager.subscribe((event) => exact.push(event), {
+      agentId: record.id,
+      replayState: false,
+    });
+    const unsubscribeOther = manager.subscribe((event) => other.push(event), {
+      agentId: "00000000-0000-4000-8000-000000000002",
+      replayState: false,
+    });
+    try {
+      const request = {
+        agentId: record.id,
+        expectedUpdatedAt: record.updatedAt,
+        expectedAttentionTimestamp: record.attentionTimestamp ?? null,
+      };
+      expect(await manager.acknowledgeAgentAttention(request)).toBe("seen");
+      expect(await manager.acknowledgeAgentAttention(request)).toBe("already_seen");
+      const seen = {
+        ...record,
+        requiresAttention: false,
+        attentionReason: null,
+        attentionTimestamp: null,
+      };
+      expect(await storage.get(record.id)).toEqual(seen);
+      expect(exact).toEqual([{ type: "stored_agent_state", record: seen }]);
+      expect(other).toEqual([]);
+      expect(manager.getRegisteredProviderIds()).toEqual([]);
+      expect(manager.getAgent(record.id)).toBeNull();
+    } finally {
+      unsubscribeExact();
+      unsubscribeOther();
+    }
+  },
+);
+
+test("stored permission needs and internal records remain unread without an acknowledgement event", async () => {
+  const { record, storage, manager } = await createStoredError({ attentionReason: "permission" });
+  const events: AgentManagerEvent[] = [];
+  const unsubscribe = manager.subscribe((event) => events.push(event), { includeInternal: true });
+  try {
+    const request = {
+      agentId: record.id,
+      expectedUpdatedAt: record.updatedAt,
+      expectedAttentionTimestamp: record.attentionTimestamp ?? null,
+    };
+    expect(await manager.acknowledgeAgentAttention(request)).toBe("needs_input");
