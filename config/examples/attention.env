# Copy to <state-root>/.env and chmod 600 it: the daemon refuses a .env that
# group or other users can read. Plain KEY=VALUE lines and # comments only.
# Each key is optional; a key that is set beats the same field in attention.yml,
# which may then omit it. Kinds and timeouts stay in attention.yml.
# Read once at daemon start: restart the daemon after editing this file.

# Comma-separated Teams identities, at most 10. Each one is @mentioned.
KONTOR_ATTENTION_MENTIONS=operator@example.com,second-operator@example.com

# Replaces the url of the one teams_workflow sink.
KONTOR_ATTENTION_TEAMS_URL=https://example.logic.azure.com/workflows/attention
