{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kontor-desktop",
  "version": "0.1.0",
  "identifier": "io.github.carasent-asma.kontor.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter kontor-console dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter kontor-console build",
    "frontendDist": "../../console/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kontor",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Kontor operator console",
    "longDescription": "The operator console for a Kontor realm. Reads one realm over its authenticated loopback /v1 contract."
  }
}
