{
  "name": "@carasent/kontor-paseo-plugin-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Isolated review prototype: renders the Kontor Paseo plugin's own client source on react-native-web with a fixture host. Never installed into Paseo.",
