    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.4",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "lucide-react": "1.50.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-web": "0.21.4",
    "typescript": "5.9.3",
    "vite": "8.2.4",
    "vitest": "4.1.12",
    "zod": "4.6.6"
  }
}
