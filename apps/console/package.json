{
  "name": "kontor-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kontor operator console",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript ../../crates/kontor-api/contract/openapi.json -o src/api/schema.d.ts",
    "verify:api": "openapi-typescript ../../crates/kontor-api/contract/openapi.json -o /tmp/kontor-schema.d.ts && diff -u src/api/schema.d.ts /tmp/kontor-schema.d.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-stronghold": "2.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
